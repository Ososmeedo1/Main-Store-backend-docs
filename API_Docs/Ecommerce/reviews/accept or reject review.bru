      server: Vercel
      strict-transport-security: max-age=63072000; includeSubDomains; preload
      x-powered-by: Express
      x-vercel-cache: MISS
      x-vercel-id: fra1::iad1::hr62m-1791657096623-1eb0670cb357
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Review has been accepted successfully",
          "data": {
            "_id": "6aca84564ff66622d81e090b",
