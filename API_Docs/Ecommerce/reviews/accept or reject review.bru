example {
  name: Accept or reject review
  description: Moderates a product review submitted by a customer. This endpoint allows an admin to either approve a review to make it publicly visible to other customers, or reject it if it violates guidelines or is inappropriate. Once you choose to approve or reject, that status is recorded. Approved reviews appear on the product page, while rejected reviews are hidden from public view.
  
  request: {
    url: {{url}}/reviews/action/6aca84564ff66622d81e090b
    method: PATCH
    mode: json
    headers: {
      token: {{token}}
    }
  
    body:json: {
      {
        "action": "accepted"
      }
    }
  }
  
  response: {
    headers: {
      access-control-allow-origin: *
      cache-control: public, max-age=0, must-revalidate
      content-length: 317
