meta {
  name: list reviews
  type: http
  seq: 2
}

get {
  url: {{url}}/reviews/list/6aca805f26b507a8773ecd91
  body: none
  auth: inherit
}

headers {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: List reviews
  description: '''
    This endpoint lists all reviews for one product: GET /reviews/list/:productId.

    Authentication: required. Send the JWT in the token header (Buyer or Admin).
    The endpoint returns every review document for the product; it does not
    filter by reviewStatus and it does not paginate.

    URL parameter:
    - productId (required): the product's MongoDB ObjectId, a 24-character
      hexadecimal string (for example 6aca805f26b507a8773ecd91).

    Expected productId format: ^[a-fA-F0-9]{24}$.
    This route does not validate productId with Joi. A malformed value reaches
    Mongoose, throws a CastError, and the API answers 500 Internal Server Error.
    Always pass the product's real _id.

    Populated fields returned by the controller:
    - userId: { username, email } (the password is never selected)
    - productId: { title }

    Review fields returned:
    - _id
    - reviewRating: number from 0 to 5
    - reviewBody: string (may be empty)
    - reviewStatus: "pending", "accepted" or "rejected"
    - createdAt / updatedAt: ISO date strings

    Success — 200 OK:
    {
      "message": "done",
      "data": [
        {
          "_id": "6aca84564ff66622d81e090b",
          "userId": {
            "username": "osama",
            "email": "osama1@gmail.com"
          },
          "productId": {
            "title": "Big Shanta"
          },
          "reviewRating": 5,
          "reviewBody": "Good quality",
          "reviewStatus": "pending",
          "createdAt": "2026-10-10T18:30:46.927Z",
          "updatedAt": "2026-10-10T18:30:46.927Z"
        }
      ]
    }

    Empty reviews — 404 Not Found:
    {
      "message": "No Reviews yet",
      "error": null,
      "stack": null
    }

    Missing token — 400 Bad Request:
    {
      "message": "Not logged in",
      "error": null,
      "stack": null
    }

    Invalid productId — 500 Internal Server Error (stack trimmed):
    {
      "message": "Internal Server Error",
      "error": "Error handle middleware",
      "stack": "CastError: Cast to ObjectId failed for value \"not-an-object-id\" (type string) at path \"productId\""
    }

    An invalid or expired JWT is thrown by the auth middleware and currently
    also surfaces as 500 with the JWT error message (for example "jwt malformed"
    or "invalid signature").
  '''
  
  request: {
    url: {{url}}/reviews/list/6aca805f26b507a8773ecd91
    method: GET
    mode: none
    headers: {
      token: {{token}}
    }
  }
  
  response: {
    headers: {
      access-control-allow-origin: *
      cache-control: public, max-age=0, must-revalidate
      content-length: 512
      content-type: application/json; charset=utf-8
      date: Sat, 10 Oct 2026 18:31:02 GMT
      etag: W/"200-pU9PZvac4f8dYdYGSfBvRL3iT4o"
      server: Vercel
      strict-transport-security: max-age=63072000; includeSubDomains; preload
      x-powered-by: Express
      x-vercel-cache: MISS
      x-vercel-id: fra1::iad1::w26nh-1791657062015-9f67478d161d
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "done",
          "data": [
            {
              "_id": "6aca84564ff66622d81e090b",
              "userId": {
                "username": "osama",
                "email": "osama1@gmail.com"
              },
              "productId": {
                "title": "Big Shanta"
              },
              "reviewRating": 5,
              "reviewBody": "Good quality",
              "reviewStatus": "pending",
              "createdAt": "2026-10-10T18:30:46.927Z",
              "updatedAt": "2026-10-10T18:30:46.927Z"
            }
          ]
        }
      '''
    }
  }
}
