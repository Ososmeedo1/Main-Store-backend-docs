meta {
  name: list reviews
  type: http
  seq: 2
}

get {
  url: {{url}}/reviews
  body: none
  auth: inherit
}

headers {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: List reviews
  description: '''
    This endpoint gets all reviews.
        
    It uses ApiFeatures when implemented in the list flow, so it can support:
        
    pagination
    filtering by product or user
    sorting by rating
    searching review text
    Examples:
        
    GET /reviews?page=1&limit=10
    GET /reviews?productId=123
    GET /reviews?sort=-reviewRating
    Simple meaning: this API is used to show customer reviews with filtering and sorting.
  '''
  
  request: {
    url: {{url}}/reviews
    method: GET
    mode: none
    headers: {
      token: {{token}}
    }
  }
  
  response: {
    headers: {
      access-control-allow-origin: *
      age: 0
      cache-control: public, max-age=0, must-revalidate
      content-length: 512
      content-type: application/json; charset=utf-8
      date: Sat, 10 Oct 2026 18:31:02 GMT
      etag: W/"200-pU9PZvac4f8dYdYGSfBvRL3iT4o"
      server: Vercel
      strict-transport-security: max-age=63072000; includeSubDomains; preload
      x-powered-by: Express
      x-vercel-cache: MISS
      x-vercel-id: fra1::iad1::w26nh-1791657062015-9f67478d161d
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "done",
          "data": [
            {
              "_id": "6ac15fd433488f956288a309",
              "userId": null,
