meta {
  name: Get user's orders
  type: http
  seq: 3
}

get {
  url: {{url}}/orders
  body: none
  auth: inherit
}

headers {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: Get user's orders
  description: '''
    This endpoint gets all orders for the logged-in user.
        
    It returns the user’s order history
    It may include statuses and totals
    Simple meaning: this API is used to view a user’s order history.
  '''
  
  request: {
    url: {{url}}/orders
    method: GET
    mode: none
    headers: {
      token: {{token}}
    }
  }
  
