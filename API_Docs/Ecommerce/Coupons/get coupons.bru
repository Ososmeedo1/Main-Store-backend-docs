meta {
  name: get coupons
  type: http
  seq: 2
}

get {
  url: {{url}}/coupons/?isEnabled=true
  body: none
  auth: inherit
}

params:query {
  isEnabled: true
}

headers {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: Get enabled coupons
  description: '''
    This endpoint gets all available coupons.
        
    It uses ApiFeatures, so it supports:
        
    pagination
    filtering
    sorting
    searching
    Examples:
        
    GET /coupons?page=1&limit=10
    GET /coupons?search=summer
    GET /coupons?sort=-discount
    Simple meaning: this API is used to show coupon offers to users.
  '''
  
  request: {
    url: {{url}}/coupons/?isEnabled=true
    method: GET
    mode: none
    params:query: {
      isEnabled: true
    }
  
    headers: {
      token: {{token}}
    }
  }
  
