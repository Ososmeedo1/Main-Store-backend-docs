}

body:json {
  {
    "couponCode": "code7",
    "from": "2026-10-10",
    "till": "2027-09-26",
    "couponType": "Fixed",
    "couponAmount": 100,
    "Users": [
      {
        "userId": "6aca4785ef0bfa241a51c8a8",
        "maxCount": 5
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: Add coupon for a user
  description: Creates a new discount coupon code that can be applied during checkout. You need to provide a unique coupon code (like "SAVE50" or "SUMMER2025"), the validity period (start and end dates), the discount amount, and the type of discount (fixed amount or percentage). You can also specify which users are allowed to use this coupon. This is useful for promotions, seasonal sales, and customer incentives.
  
  request: {
    url: {{url}}/coupons/add
    method: POST
    mode: json
    headers: {
      token: {{token}}
    }
  
    body:json: {
      {
        "couponCode": "code7",
        "from": "2026-10-10",
        "till": "2027-09-26",
        "couponType": "Fixed",
        "couponAmount": 100,
        "Users": [
          {
            "userId": "6aca4785ef0bfa241a51c8a8",
            "maxCount": 5
          }
        ]
      }
    }
  }
  
