meta {
  name: add category
  type: http
  seq: 1
}

post {
  url: {{url}}/categories/add
  body: multipartForm
  auth: inherit
}

headers {
  token: {{token}}
}

body:multipart-form {
  image: @file(C:\Users\ososm\OneDrive\Pictures\Screenshots\Screenshot 2026-10-10 171012.png) @contentType(image/png)
  name: Bags
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: Add category
  description: Creates a new main product category in the system. This is used to organize products into broad groups like "Electronics", "Clothing", "Books", etc. When you add a category, you need to provide a unique name and an image that represents the category. The system automatically creates a slug from the name and stores the image in cloud storage. Each category is identified by a unique ID and tracks which admin created it.
  
  request: {
    url: {{url}}/categories/add
    method: POST
    mode: multipartForm
    headers: {
      token: {{token}}
    }
  
    body:multipart-form: {
      image: @file(C:\Users\ososm\OneDrive\Pictures\Screenshots\Screenshot 2026-10-10 171012.png) @contentType(image/png)
      name: Bags
    }
  }
  
