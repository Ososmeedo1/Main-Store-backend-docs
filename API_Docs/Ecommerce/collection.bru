      │   ├── Sub-Categories/ ← Sub-categories
      │   ├── Brands/       ← Product brands
      │   ├── Cart/         ← Shopping cart
      │   ├── Orders/       ← Customer orders
      │   ├── Coupons/      ← Discount codes
      │   ├── Reviews/      ← Product reviews
      │   ├── Addresses/    ← Delivery addresses
      │   └── index.js
