          ├── crons.utils.js          ← Scheduled tasks
          ├── enum.utils.js           ← Constants and enums
          ├── error-class.utils.js    ← Custom error handling
          ├── file-extensions.utils.js ← Validates file types
          ├── general-rules.utils.js  ← Common validation rules
          ├── imagekit.utils.js       ← Image upload to cloud
