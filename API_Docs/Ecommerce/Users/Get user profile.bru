meta {
  name: Get user profile
  type: http
  seq: 5
}

get {
  url: {{url}}/users/profile
  body: none
  auth: inherit
}

headers {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: Get user's data
  description: '''
    This endpoint returns the current user’s profile.
        
    It gets the user information
    It also gets the default address
    It hides the password in the response
    Simple meaning: this API is used to fetch the logged-in user data.
  '''
  
  request: {
    url: {{url}}/users/profile
    method: GET
    mode: none
    headers: {
      token: {{token}}
    }
  }
  
