meta {
  name: Reset password copy
  type: http
  seq: 8
}

post {
  url: {{url}}/users/reset-password
  body: json
  auth: inherit
}

body:json {
  {
    "newPassword": "Example123#",
    "resetToken": "example tokem"
  }
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}

example {
  name: Final phase of forgotten password phases
  description: '''
    This endpoint sets a new password.
              
    It receives the reset token and new password
    It validates the token
    It updates the password
    Simple meaning: this API is used to finish the password reset process.
  '''
  
  request: {
    url: {{url}}/users/reset-password
    method: POST
    mode: json
    body:json: {
      {
        "newPassword": "Example123#",
        "resetToken": "example tokem"
      }
    }
  }
  
  response: {
    headers: {
      x-powered-by: Express
      access-control-allow-origin: *
      content-type: application/json; charset=utf-8
      content-length: 50
      etag: W/"32-UaUy7tfbZZyjeJ37A3tJKM9g9+U"
      date: Sat, 03 Oct 2026 19:04:26 GMT
      connection: keep-alive
      keep-alive: timeout=5
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Password has been reset successfully"
        }
      '''
    }
  }
}
