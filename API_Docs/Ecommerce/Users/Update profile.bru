meta {
  name: Update profile
  type: http
  seq: 2
}

put {
  url: {{url}}/users/update
  body: json
  auth: inherit
}

headers {
  token: {{token}}
}

body:json {
  {
    "password": "Osama321#"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: Update profile's data
  description: '''
    This endpoint updates the logged-in user’s information.
        
    It can update password, email, username, phone, and other account fields
    It can also update the default address
    Simple meaning: this API is used when a user edits their profile.
  '''
  
  request: {
    url: {{url}}/users/update
    method: PUT
    mode: json
    headers: {
      token: {{token}}
    }
  
    body:json: {
      {
        "password": "Osama321#"
      }
    }
  }
  
  response: {
