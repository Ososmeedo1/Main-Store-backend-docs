}

example {
  name: Register
  description: '''
    This endpoint creates a new user account.
      
    It receives username, email, password, and address details
    It validates the data
    It creates the user and default address
    Simple meaning: this API is used when a new user signs up.
  '''
  
  request: {
    url: {{url}}/users/register
    method: POST
    mode: json
    body:json: {
      {
        "username": "osama1",
        "email": "osama1@gmail.com",
        "password": "Osama123#",
        "age": 30,
        "phone": "01000000001",
        "userType": "Admin",
        "gender": "male",
        "country": "Egypt",
        "city": "Cairo",
        "postalCode": "848481",
        "buildingNumber": "3",
        "floorNumber": 5,
        "addressLabel": "home"
          
      }
    }
  }
  
