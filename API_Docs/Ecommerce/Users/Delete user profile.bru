example {
  name: Delete user's account
  description: '''
    This endpoint deletes the logged-in user account.
        
    It finds the user
    It removes the account from the database
    It returns success
    Simple meaning: this API is used when the user deletes their account.
  '''
  
  request: {
    url: {{url}}/users/delete
    method: DELETE
    mode: none
    headers: {
      token: {{token}}
    }
  }
  
  response: {
    headers: {
