meta {
  name: Forgot password copy
  type: http
  seq: 6
}

patch {
  url: {{url}}/users/forgot-password
  body: json
  auth: inherit
}

body:json {
  {
    "email": "username@gmail.com"
  }
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}

example {
  name: First phase of forgotten password phases
  description: '''
    This endpoint starts the password reset flow.
        
    It checks if the email exists
    It creates an OTP token for password reset
    Simple meaning: this API is used when a user forgets their password.
  '''
  
  request: {
    url: {{url}}/users/forgot-password
    method: PATCH
    mode: json
    body:json: {
      {
        "email": "username@gmail.com"
      }
    }
  }
  
  response: {
    headers: {
      x-powered-by: Express
      access-control-allow-origin: *
      content-type: application/json; charset=utf-8
      content-length: 380
      etag: W/"17c-4lSwmBYGOKRoFK74ao9dhffbrGc"
      date: Sat, 03 Oct 2026 19:03:57 GMT
      connection: keep-alive
      keep-alive: timeout=5
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Otp has been sent on you email ososmeedo@gmail.com successfully",
          "data": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJlbWFpbCI6Im9zb3NtZWVkb0BnbWFpbC5jb20iLCJ0eXBlIjoicmVzZXRPdHAiLCJoYXNoZWhkT3RwIjoiJDJiJDEwJFF5VU8uVWRCZmI4OHdCeVRDL2ttRi5KN0pjQi9kb1JzZ3dFcEREejlFMHVOLkh1c0ZYQ3RhIiwiaWF0IjoxNzkxMDU0MjM2LCJleHAiOjE3OTEwNTQ4MzZ9.A3ELUWSkpyBySP_S9zkGFtS3Im90zFyTm5kgODNxIY0"
        }
