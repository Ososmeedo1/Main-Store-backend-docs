meta {
  name: List sub categories
  type: http
  seq: 5
}

get {
  url: {{url}}/subcategories
  body: none
  auth: inherit
}

headers {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: Get all sub-categories
  description: This endpoint is used to get a list of all sub-categories. It also uses ApiFeatures, so it supports: pagination filtering searching sorting Examples: GET /sub-categories?page=1&limit=10 → page 1, 10 sub-categories GET /sub-categories?categoryId=123 → show sub-categories under a specific category GET /sub-categories?search=shoes → search sub-category names GET /sub-categories?sort=name → sort from A to Z The response includes: total: total number of matching sub-categories page: current page data: list of sub-categories Simple meaning: this API is for showing many sub-categories with search, filter, and page options.
  
  request: {
    url: {{url}}/subcategories
    method: GET
    mode: none
    headers: {
      token: {{token}}
    }
  }
  
