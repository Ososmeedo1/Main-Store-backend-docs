example {
  name: Delete sub-category
  description: Permanently removes a sub-category from the system. When you delete a sub-category, all brands associated with that sub-category are automatically deleted as well (cascading deletion). The sub-category images are removed from cloud storage.
  
  request: {
    url: {{url}}/subcategories/6aca491def0bfa241a51c8c7
    method: DELETE
    mode: none
    headers: {
      token: {{token}}
    }
  }
  
