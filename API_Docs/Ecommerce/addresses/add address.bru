meta {
  name: add address
  type: http
  seq: 1
}

post {
  url: {{url}}/addresses/add
  body: json
  auth: inherit
}

headers {
  token: {{token}}
}

body:json {
  {
    "country": "Egypt",
    "city": "Giza",
    "postalCode": 656565,
    "buildingNumber": "51",
    "floorNumber": 2,
    "addressLabel": "Home",
    "setAsDefault": true
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: Add address
  description: '''
    This endpoint adds a new address for the user.
        
    It receives address details
    It saves the new address
    It can set it as default
    Simple meaning: this API is used when a user adds a shipping or billing address.
  '''
  
  request: {
    url: {{url}}/addresses/add
    method: POST
    mode: json
    headers: {
      token: {{token}}
    }
  
    body:json: {
      {
        "country": "Egypt",
        "city": "Giza",
        "postalCode": 656565,
        "buildingNumber": "51",
        "floorNumber": 2,
        "addressLabel": "Home",
        "setAsDefault": true
      }
    }
  }
  
  response: {
    headers: {
      access-control-allow-origin: *
      cache-control: public, max-age=0, must-revalidate
      content-length: 350
